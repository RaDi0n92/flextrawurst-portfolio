[Unit]
Description=AI-Strom-Brücke — DISABLED: forbidden vision runner
RefuseManualStart=yes
After=ai-strom-bruecke-stream.service ai-strom-bruecke-observer.service
Wants=ai-strom-bruecke-stream.service ai-strom-bruecke-observer.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/werkraum/_shared/ai_strom_bruecke/vision_runner.py --upstream http://127.0.0.1:8098/stream --bind 127.0.0.1 --port 8099
Restart=always
RestartSec=1
User=root

[Install]
WantedBy=multi-user.target
