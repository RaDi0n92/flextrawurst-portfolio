[Unit]
Description=AI-Strom-Brücke — DISABLED: visual frame feed forbidden
RefuseManualStart=yes
After=ai-strom-bruecke.service ai-strom-bruecke-observer.service
Wants=ai-strom-bruecke.service ai-strom-bruecke-observer.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /root/werkraum/_shared/ai_strom_bruecke/stream_server.py --bind 127.0.0.1 --port 8098
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
