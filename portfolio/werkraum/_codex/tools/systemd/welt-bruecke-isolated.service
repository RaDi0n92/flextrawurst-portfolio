[Unit]
Description=Welt-Brücke — Selbstmodelle nach PostgreSQL, isoliert
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
DynamicUser=yes
User=flex_bridge
Group=flex_bridge
WorkingDirectory=/root/werkraum/welt
ExecStart=/usr/bin/env "FLEXTRAWURST_DB_URI=dbname=flextrawurst user=flex_bridge host=/var/run/postgresql" BRUECKE_LOG_DIR=/var/log/flextrawurst BRUECKE_LOG_PATH=/var/log/flextrawurst/welt-bruecke.log /root/werkraum/venv/bin/python3 /root/werkraum/welt/bruecke.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
LogsDirectory=flextrawurst

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/root/werkraum/.agent
ReadWritePaths=/var/log/flextrawurst

[Install]
WantedBy=multi-user.target
