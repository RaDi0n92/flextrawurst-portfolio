[Unit]
Description=GENI Hörer — hört alles, schweigt bis Daniel spricht (sandboxed)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=root
EnvironmentFile=/root/werkraum/.agent/flarum.env
ExecStart=/usr/bin/python3 /root/werkraum/geni/hoerer.py
Restart=always
RestartSec=10
StandardOutput=null
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=077

InaccessiblePaths=/root/.ssh /root/.claude /root/.codex /root/.gemini /root/.config /root/werkraum/.agent
ReadWritePaths=/root/geni_gedaechtnis /root/werkraum_geni/tagebuch /root/werkraum_geni/hoerer.log

[Install]
WantedBy=multi-user.target
