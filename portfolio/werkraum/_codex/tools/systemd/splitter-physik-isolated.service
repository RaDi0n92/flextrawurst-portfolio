[Unit]
Description=Splitter-Physik Daemon — 60s Takt, isoliert
After=network.target postgresql.service welt-api.service
Wants=postgresql.service

[Service]
Type=simple
DynamicUser=yes
User=flex_splitter
Group=flex_splitter
WorkingDirectory=/root/werkraum/welt

# The old db-env drop-in may still exist; env(1) makes the process use the
# peer-bound role explicitly without exposing the old application credential.
ExecStart=/usr/bin/env "FLEXTRAWURST_DB_URI=dbname=flextrawurst user=flex_splitter host=/var/run/postgresql" SPLITTER_LOG_PATH=/var/log/flextrawurst/splitter-physik.log /root/werkraum/venv/bin/python3 /root/werkraum/welt/splitter_daemon.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
LogsDirectory=flextrawurst

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/root/werkraum/.agent
ReadWritePaths=/var/log/flextrawurst

[Install]
WantedBy=multi-user.target
