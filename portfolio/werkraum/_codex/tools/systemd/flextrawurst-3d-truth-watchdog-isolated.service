[Unit]
Description=Flextrawurst 3D project live truth watchdog (sandboxed)
After=local-fs.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/werkraum/MCP-VPS-CHATGPT-Spiel-schritfürschritt-aufbau-3d-spieewelt-traum
ExecStart=/usr/bin/python3 /root/werkraum/MCP-VPS-CHATGPT-Spiel-schritfürschritt-aufbau-3d-spieewelt-traum/truth_engine/watchdog_service.py --config /root/werkraum/MCP-VPS-CHATGPT-Spiel-schritfürschritt-aufbau-3d-spieewelt-traum/truth_engine/config.json
Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077
LimitNOFILE=8192
Nice=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# Die Pipeline braucht für atomare Root-Ausgaben den Projektcontainer als
# Schreibpfad. Die vorhandenen Quellen werden darunter explizit read-only
# überlagert; schreibbar bleiben nur die generierten Ausgabeschichten.
ReadWritePaths=/root/werkraum/MCP-VPS-CHATGPT-Spiel-schritfürschritt-aufbau-3d-spieewelt-traum
ReadWritePaths=/root/werkraum/MCP-VPS-CHATGPT-Spiel-schritfürschritt-aufbau-3d-spieewelt-traum/truth_engine
ReadWritePaths=/root/werkraum/MCP-VPS-CHATGPT-Spiel-schritfürschritt-aufbau-3d-spieewelt-traum/truth_engine/runtime
