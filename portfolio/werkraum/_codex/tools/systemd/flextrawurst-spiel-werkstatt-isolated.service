[Unit]
Description=Flextrawurst Spiel-Werkstatt 2026-08-19 (sandboxed)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/werkraum/engine/godot-vertical-slice/workshop_20260819
ExecStart=/usr/bin/python3 /root/werkraum/engine/godot-vertical-slice/workshop_20260819/server.py
Environment=FLEXTRAWURST_WORKSHOP_HOST=127.0.0.1
Environment=FLEXTRAWURST_WORKSHOP_PORT=18119
Environment=FLEXTRAWURST_WORKSHOP_RUNTIME=/root/werkraum/engine_runtime/godot-vertical-slice/workshop_20260819
Restart=on-failure
RestartSec=2
StandardOutput=journal
StandardError=journal

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=127.0.0.1
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=077

# Die Werkstatt liest die bekannten Spielquellen und schreibt nur ihren
# versionierten Laufzeitbestand. Zugangsschichten bleiben verborgen.
ReadWritePaths=/root/werkraum/engine_runtime/godot-vertical-slice/workshop_20260819
InaccessiblePaths=/root/.ssh /root/.claude /root/.codex /root/.gemini /root/.config /root/werkraum/.agent

[Install]
WantedBy=multi-user.target
