[Unit]
Description=WorldWORDS ANTIBIBEL atomic backup
After=postgresql.service

[Service]
Type=oneshot
User=worldwords
Group=worldwords
WorkingDirectory=/root/werkraum/WorldWORDS-ANTIBIBEL-Website
ExecStart=/root/werkraum/WorldWORDS-ANTIBIBEL-Website/scripts/backup.sh
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/root/werkraum/WorldWORDS-ANTIBIBEL-Website/backups /root/werkraum/WorldWORDS-ANTIBIBEL-Website/exports /root/werkraum/WorldWORDS-ANTIBIBEL-Open-Source/data/live
